{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "gen:engine": "bash scripts/gen-engine-client.sh",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/db/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/db/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/db/data-source.ts migration:revert",
    "migration:run:prod": "typeorm -d dist/db/data-source.js migration:run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-fastify": "^12.6.2",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@types/node": "^26.6.10",
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
