# Host ports (3000 / 5432 are often taken by other projects)
PORT=3100
API_PORT=3100
DB_PORT=5433
# Used when running the api on your machine (npm run start:dev).
# docker-compose overrides this with host "db" inside the container.
DATABASE_URL=postgresql://app:app@localhost:5433/app
# Engine machine on the private network, e.g. http://engine.internal:8080
ENGINE_URL=http://localhost:8080
ENGINE_KEY=dev-key
# ENGINE_KEY above matches the engine's `make run`. Use a long random value in production.
SESSION_SECRET=change-me
